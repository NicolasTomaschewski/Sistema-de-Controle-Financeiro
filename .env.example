# Copie este arquivo para .env e ajuste os valores conforme o ambiente local.
# Nenhum valor abaixo é uma credencial real.

# Ambiente: development | test | production
APP_ENV=development

# Porta HTTP do backend
HTTP_PORT=8080

# String de conexão com o PostgreSQL (database/sql + driver pgx)
# Ao usar o docker-compose.yml fornecido, a porta exposta é 5432.
DATABASE_URL=postgres://finctrl:finctrl_local_dev@localhost:5432/finctrl?sslmode=disable

# Segredo usado para assinar/derivar tokens de sessão. Gere um valor aleatório
# de pelo menos 32 caracteres, por exemplo: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-32-ou-mais-caracteres

# Define se o cookie de sessão exige HTTPS (Secure). Em desenvolvimento local
# sem HTTPS, manter como false. Em produção, SEMPRE true.
COOKIE_SECURE=false

# Origens permitidas para CORS, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Pool de conexões com o banco
DB_MAX_CONNS=10
DB_CONN_TIMEOUT=5s

# Timeouts do servidor HTTP
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
